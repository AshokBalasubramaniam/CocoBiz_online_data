# ---------- Android / Gradle ----------
# Build outputs
*.apk
*.aab
*.ap_
*.dex
build/
app/build/
app/release/
captures/
.externalNativeBuild/
.cxx/

# Local configuration (contains SDK path — machine-specific)
local.properties

# Keystore / signing
*.jks
*.keystore
keystore.properties

# Gradle caches (the wrapper jar is kept so ./gradlew works after cloning)
.gradle/

# Kotlin compiler daemon state
.kotlin/
*.class

# IDE — IntelliJ / Android Studio / VS Code
.idea/
*.iml
*.ipr
*.iws
.vscode/

# ProGuard mapping (generated per release)
app/proguard-mapping.txt

# Logs
*.log

# ---------- Rust backend ----------
backend/target/
**/*.rs.bk
*.pdb

# Secrets — never commit real env files (backend/.env.example is kept)
.env
.env.*
!.env.example

# ---------- OS / tools ----------
.DS_Store
Thumbs.db
.claude/settings.local.json
