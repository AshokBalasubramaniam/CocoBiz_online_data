# Copy this file to .env and fill in real values before running locally
# (docker compose reads .env automatically). Never commit the real .env file.

# Local dev defaults match docker-compose.yml's mongo/redis services.
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=cocobiz
# Optional — leave empty to run on MongoDB only.
REDIS_URL=redis://redis:6379

# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# Must be exactly 64 hex characters (32 bytes / AES-256 key).
# Generate with: openssl rand -hex 32
# Losing this key makes every encrypted record in MongoDB unrecoverable —
# back it up somewhere safe outside of git.
ENCRYPTION_KEY=

JWT_TTL_SECONDS=604800
CACHE_TTL_SECONDS=300
PORT=4000
